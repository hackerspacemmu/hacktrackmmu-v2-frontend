{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hacktrackmmu-frontend-v2",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Enables versioned + per-PR aliased preview URLs (see .github/workflows/pr-preview.yml).
  "preview_urls": true,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": false
  }
}
